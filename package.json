{
  "name": "@nodeops-createos/n8n-nodes-sandbox",
  "version": "0.1.0",
  "description": "n8n community node for CreateOS sandboxes - create and manage sandboxes, run commands, transfer files, and manage templates, networks, and disks.",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "homepage": "https://github.com/createos/n8n-nodes-createos#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "createos",
    "sandbox",
    "code-execution",
    "ai-agents"
  ],
  "author": {
    "name": "CreateOS",
    "email": "hello@createos.sh",
    "url": "https://createos.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/createos/n8n-nodes-createos.git"
  },
  "bugs": {
    "url": "https://github.com/createos/n8n-nodes-createos/issues"
  },
  "scripts": {
    "build": "n8n-node build && node scripts/bundle-node.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:basic": "eslint . --config eslint.basic.config.mjs",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/CreateOSApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CreateOS/CreateOs.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "eslint": "9.29.0",
    "n8n-workflow": "^2.27.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
